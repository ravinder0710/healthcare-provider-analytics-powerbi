/* ==============================================================================================
   HEALTHCARE PROVIDER ANALYTICS & REVENUE CYCLE MANAGEMENT (RCM) - DAX MEASURES VAULT
   Author: Ravinder Gupta (Data Analyst & BI Specialist)
   Dataset: 5,000 Patient Encounters across UK Provider Clinics & Hospitals
   Architecture: Star/Snowflake Semantic Model with Dynamic Field Parameters & Disconnected Tables
   ============================================================================================== */

// ==============================================================================================
// 1. CORE VOLUME & ADMISSION MEASURES
// ==============================================================================================

Total Visits = 
COUNTROWS(Visits)

Total Patients = 
DISTINCTCOUNT(Visits[Patient ID])

Total Providers = 
DISTINCTCOUNT(Visits[Provider ID])

Total Outpatient = 
COUNTBLANK(visits[Length of Stay])

Total Admitted = 
[Total Visits] - [Total Outpatient]


// ==============================================================================================
// 2. FINANCIAL & REVENUE CYCLE MANAGEMENT (RCM) MEASURES
// ==============================================================================================

Total Medication Cost = 
SUM(Visits[Medication Cost])

Total Treatment Cost = 
SUM(Visits[Treatment Cost])

Total Room Charges = 
SUMX(
    Visits,
    Visits[Room Charges(daily rate)]
        *
    Visits[Length of Stay]
)

Total Billing Amount = 
[Total Medication Cost]
+
[Total Room Charges]
+
[Total Treatment Cost]

Total Insurance Coverage = 
SUM(Visits[Insurance Coverage])

Out Of Pocket = 
[Total Billing Amount]
-
[Total Insurance Coverage]


// ==============================================================================================
// 3. AVERAGE UNIT ECONOMICS (DUAL-CARD SUBTITLES)
// ==============================================================================================

Avg Billing Per Visit = 
DIVIDE([Total Billing Amount], [Total Visits], 0)

Avg Medication Cost = 
DIVIDE([Total Medication Cost], [Total Visits], 0)

Avg Treatment Cost = 
DIVIDE([Total Treatment Cost], [Total Visits], 0)

Avg Insurance Coverage = 
DIVIDE([Total Insurance Coverage], [Total Visits], 0)

Avg Room Charges = 
DIVIDE([Total Room Charges], [Total Visits], 0)

Avg Out Of Pocket = 
DIVIDE([Out Of Pocket], [Total Visits], 0)


// ==============================================================================================
// 4. RATIO & CONTRIBUTION MEASURES (% GRAND TOTAL)
// ==============================================================================================

% Department = 
DIVIDE(
    [Total Billing Amount],
    CALCULATE(
        [Total Billing Amount],
        ALL(departments[Department])
    )
)

% Procedure = 
DIVIDE(
    [Total Billing Amount],
    CALCULATE(
        [Total Billing Amount],
        ALL(procedures[Procedure])
    )
)

Active Department = 
SELECTEDVALUE(departments[Department])


// ==============================================================================================
// 5. EMERGENCY VS. NON-EMERGENCY DYNAMIC SERVICE SPLIT
// ==============================================================================================

% Emergency = 
    VAR _TotalVisit = 
        CALCULATE(
            [Total Visits],
            visits[Visit Type] = "Emergency"
        )

    VAR _Admitted = 
        CALCULATE(
            [Total Admitted],
            visits[Visit Type] = "Emergency"
        )

    VAR _Outpatient = 
        CALCULATE(
            [Total Outpatient],
            visits[Visit Type] = "Emergency"
        )
    VAR _SwitchMeasures =
        SWITCH(
            TRUE(),
            SELECTEDVALUE(ChangeMeasuresLineChart[ChangeMeasuresLineChart Order])=0,
            [Total Visits],
            SELECTEDVALUE(ChangeMeasuresLineChart[ChangeMeasuresLineChart Order])=1,
            [Total Admitted],
            [Total Outpatient]
        )

    VAR _SwitchVar = 
        SWITCH(
            TRUE(),
            SELECTEDVALUE(ChangeMeasuresLineChart[ChangeMeasuresLineChart Order]) = 0, _TotalVisit,
            SELECTEDVALUE(ChangeMeasuresLineChart[ChangeMeasuresLineChart Order]) = 1, _Admitted,
            _Outpatient
        )

        RETURN
        IF(
            _SwitchVar < _SwitchMeasures,
            DIVIDE(
                _SwitchVar,
                _SwitchMeasures,
                0
            ),
            DIVIDE(
                _SwitchMeasures,
                _SwitchVar,
                0
            )
        )

% None Emergency = 
    VAR _TotalVisit = 
        CALCULATE(
            [Total Visits],
            visits[Visit Type] = "None Emergency"
        )

    VAR _Admitted = 
        CALCULATE(
            [Total Admitted],
            visits[Visit Type] = "None Emergency"
        )

    VAR _Outpatient = 
        CALCULATE(
            [Total Outpatient],
            visits[Visit Type] = "None Emergency"
        )
    VAR _SwitchMeasures =
        SWITCH(
            TRUE(),
            SELECTEDVALUE(ChangeMeasuresLineChart[ChangeMeasuresLineChart Order])=0,
            [Total Visits],
            SELECTEDVALUE(ChangeMeasuresLineChart[ChangeMeasuresLineChart Order])=1,
            [Total Admitted],
            [Total Outpatient]
        )

    VAR _SwitchVar = 
        SWITCH(
            TRUE(),
            SELECTEDVALUE(ChangeMeasuresLineChart[ChangeMeasuresLineChart Order]) = 0, _TotalVisit,
            SELECTEDVALUE(ChangeMeasuresLineChart[ChangeMeasuresLineChart Order]) = 1, _Admitted,
            _Outpatient
        )

        RETURN
        IF(
            _SwitchVar < _SwitchMeasures,
            DIVIDE(
                _SwitchVar,
                _SwitchMeasures,
                0
            ),
            DIVIDE(
                _SwitchMeasures,
                _SwitchVar,
                0
            )
        )

% R Emergency = 1.0 - [% Emergency]

% R None Emergency = 1.0 - [% None Emergency]

None Emergency Final = 
CALCULATE(
    [Total Outpatient],
    Visits[Visit Type] = "None Emergency"
)


// ==============================================================================================
// 6. PATIENT SATISFACTION SCORING
// ==============================================================================================

Avg Satisfaction Score = 
-- AvgSatisfactionScorePerProvider
VAR _Score =
    AVERAGEX(
        VALUES(visits[Provider ID]),
        CALCULATE(AVERAGE(visits[Patient Satisfaction Score]))
    )
RETURN 
    "Avg. Rating " & FORMAT(_Score, "0.00")

Patient Satisfaction Score = 
-- AvgSatisfactionScorePerProvider
VAR _Score = 
    AVERAGEX(
        VALUES(visits[Provider ID]),
        CALCULATE(AVERAGE('visits'[Patient Satisfaction Score]))
    )
RETURN
    "Patient Satisfaction Score: " & FORMAT(_Score, "0.00")


// ==============================================================================================
// 7. TIME INTELLIGENCE & GROWTH (MoM / WoW)
// ==============================================================================================

Previous Month Billing Amount = 
CALCULATE(
    [Total Billing Amount],
    DATEADD('Date Table'[Date], -1, MONTH)
)

MoM Growth Value = 
[Total Billing Amount] - [Previous Month Billing Amount]

MoM Growth % = 
DIVIDE(
    [Total Billing Amount] - [Previous Month Billing Amount],
    [Previous Month Billing Amount],
    0
)

Previous Weekday Billing Amount = 
    VAR _CurrentWeekday = SELECTEDVALUE('Date Table'[Weekday])
    VAR _PreviousWeekday = 
        SWITCH(
            _CurrentWeekday,
            "Mon", "Sun",
            "Tue", "Mon",
            "Wed", "Tue",
            "Thu", "Wed",
            "Fri", "Thu",
            "Sat", "Fri",
            "Sun", "Sat"
        )
    RETURN
        CALCULATE(
            [Total Billing Amount],
            'Date Table'[Weekday] = _PreviousWeekday,
            ALL('Date Table')
        )

WoW Growth Value = 
[Total Billing Amount] - [Previous Weekday Billing Amount]

WoW Growth % = 
DIVIDE(
    [Total Billing Amount] - [Previous Weekday Billing Amount],
    [Previous Weekday Billing Amount],
    0
)


// ==============================================================================================
// 8. VISUAL OVERLAY & DEBUG HELPERS
// ==============================================================================================

Blank Measures = 0

Debug Order = 
SELECTEDVALUE(
    ChangeMeasuresLineChart[ChangeMeasuresLineChart Order]
)

Debug TotalVisit = 
CALCULATE(
    [Total Visits],
    Visits[Visit Type] = "None Emergency"
)

Debug Admitted = 
CALCULATE(
    [Total Admitted],
    Visits[Visit Type] = "None Emergency"
)

Debug Outpatient = 
CALCULATE(
    [Total Outpatient],
    Visits[Visit Type] = "None Emergency"
)

Test Emergency = 
CALCULATE(
    [Total Visits],
    Visits[Visit Type] = "Emergency"
)

Test None Emergency = 
CALCULATE(
    [Total Visits],
    Visits[Visit Type] = "None Emergency"
)

Test None Emergency Admitted = 
CALCULATE(
    [Total Admitted],
    Visits[Visit Type] = "None Emergency"
)

Test None Emergency Outpatient = 
CALCULATE(
    [Total Outpatient],
    Visits[Visit Type] = "None Emergency"
)


// ==============================================================================================
// 9. CALCULATED COLUMNS (ON FACT VISITS)
// ==============================================================================================

// Column: Length of Stay (Raw Integer Days)
Length of Stay = 
DATEDIFF(
    Visits[Admitted Date],
    Visits[Discharge Date],
    DAY
)

// Column: Length of Stays (Binned / Grouped Range)
Length of Stays = 
    VAR _AdmissionsDays = 
        DATEDIFF(
            Visits[Admitted Date],
            Visits[Discharge Date],
            DAY
        )
    VAR _GroupDays = 
        SWITCH(
            TRUE(),
            _AdmissionsDays = 1, "1 Day",
            _AdmissionsDays <= 4, "2-4",
            _AdmissionsDays <= 7, "5-7",
            TRUE(), "8+"
        )
    RETURN
    IF(
        _AdmissionsDays = BLANK(), "", _GroupDays
    )


// ==============================================================================================
// 10. CALCULATED TABLES & FIELD PARAMETERS
// ==============================================================================================

// Table: Date Table (Master Enterprise Calendar)
Date Table = 
ADDCOLUMNS(
    CALENDARAUTO(),

    "Year", YEAR([Date]),
    "Quarter", "Q-" & QUARTER([Date]),

    "Month", FORMAT([Date], "MMM"),
    "Month Name", FORMAT([Date], "MMMM"),
    "Month Num", MONTH([Date]),

    "Weekday", FORMAT([Date], "DDD"),
    "Weekday Name", FORMAT([Date], "DDDD"),
    "Weekday Num", WEEKDAY([Date], 2),
    "WeekType", IF(WEEKDAY([Date]) = 1 || WEEKDAY([Date]) = 7, "Weekend", "Weekday"),

    "Year Month", FORMAT([Date], "YYYY-MMM"),
    "YearMonthSort", YEAR([Date]) * 100 + MONTH([Date])
)

// Field Parameter: ChangeCalendar (Granularity Switcher for Time Series)
ChangeCalendar = {
    ("Month", NAMEOF('Date Table'[Month]), 0),
    ("Quarter", NAMEOF('Date Table'[Quarter]), 1),
    ("Weekday", NAMEOF('Date Table'[Weekday]), 2),
    ("Year", NAMEOF('Date Table'[Year]), 3),
    ("WeekType", NAMEOF('Date Table'[WeekType]), 4)
}

// Field Parameter: ChangeMeasuresLineChart (Metric Switcher on Trend Visuals)
ChangeMeasuresLineChart = {
    ("Total Visits", NAMEOF('1DAX_Calculation'[Total Visits]), 0),
    ("Total Admitted", NAMEOF('1DAX_Calculation'[Total Admitted]), 1),
    ("Total Outpatient", NAMEOF('1DAX_Calculation'[Total Outpatient]), 2)
}

// Field Parameter: Patient Location Switch (City vs State Geographic Switcher)
Patient Location Switch = {
    ("City", NAMEOF('cities'[City]), 0),
    ("State", NAMEOF('cities'[State]), 1)
}

Patient Location Switch 2 = {
    ("City", NAMEOF('cities'[City]), 0),
    ("State", NAMEOF('cities'[State]), 1)
}

Parameter = {
    ("Total Visits", NAMEOF('1DAX_Calculation'[Total Visits]), 0)
}
