Role: Data Analyst & BI Specialist
Target: NHS UK / Hospital Provider Network Analytics
========================================================================================
*/

// =====================================================================================
// 1. DATE TABLE GENERATION (Star Schema Dimension)
// =====================================================================================

Date Table = 
ADDCOLUMNS(
    CALENDARAUTO(),
    "Year", YEAR([Date]),
    "Year Quarter", FORMAT([Date], "YYYY-\QQ"),
    "Month Number", MONTH([Date]),
    "Month Name", FORMAT([Date], "mmmm"),
    "Short Month", FORMAT([Date], "mmm"),
    "Month Year", FORMAT([Date], "mmm yyyy"),
    "Quarter", "Q" & FORMAT([Date], "Q"),
    "Day of Week", WEEKDAY([Date], 2),
    "Day Name", FORMAT([Date], "dddd"),
    "Short Day", FORMAT([Date], "ddd"),
    "Is Weekend", IF(WEEKDAY([Date], 2) IN {6, 7}, "Weekend", "Weekday")
)


// =====================================================================================
// 2. CALCULATED COLUMNS (Fact Table: Visits)
// =====================================================================================

// Length of Stay in Days (Admitted to Discharge)
Visits[Length of Stay] = 
DATEDIFF(Visits[Admitted Date], Visits[Discharge Date], DAY)


// =====================================================================================
// 3. BASE OPERATIONAL VOLUME MEASURES
// =====================================================================================

// Total Clinical Visits Encountered
[Total Visits] = COUNTROWS(Visits)

// Unique Patients Served
[Total Patients] = DISTINCTCOUNT(Visits[Patient ID])

// Inpatient Visits
[Inpatient Visits] = 
CALCULATE(
    [Total Visits],
    Visits[Service Type] = "Inpatient"
)

// Outpatient Visits
[Outpatient Visits] = 
CALCULATE(
    [Total Visits],
    Visits[Service Type] = "Outpatient"
)

// Emergency Admissions
[Emergency Visits] = 
CALCULATE(
    [Total Visits],
    Visits[Emergency Visit] = "Yes"
)

// Average Length of Stay (ALOS in Days)
[Avg Length of Stay] = 
AVERAGE(Visits[Length of Stay])


// =====================================================================================
// 4. FINANCIAL & REVENUE CYCLE MANAGEMENT (RCM) MEASURES
// =====================================================================================

// Total Room Charges (Iterator: Daily Room Rate * Length of Stay Days)
[Total Room Charges] = 
SUMX(
    Visits,
    COALESCE(Visits[Room Charges(daily rate)], 0) * COALESCE(Visits[Length of Stay], 0)
)

// Total Treatment / Procedure Charges
[Total Treatment Cost] = SUM(Visits[Treatment Cost])

// Total Pharmacy / Medication Charges
[Total Medication Cost] = SUM(Visits[Medication Cost])

// Total Gross Billing Revenue (£)
[Total Billing Amount] = 
[Total Medication Cost] + [Total Treatment Cost] + [Total Room Charges]

// Total Insurance Covered / Reimbursed (£)
[Total Insurance Coverage] = SUM(Visits[Insurance Coverage])

// Patient Out-of-Pocket Expense (Self-Pay Liability)
[Total Out Of Pocket] = 
[Total Billing Amount] - [Total Insurance Coverage]

// Insurance Coverage Ratio (%)
[Insurance Coverage %] = 
DIVIDE([Total Insurance Coverage], [Total Billing Amount], 0)

// Out of Pocket Ratio (%)
[Out Of Pocket %] = 
DIVIDE([Total Out Of Pocket], [Total Billing Amount], 0)


// =====================================================================================
// 5. PER-VISIT UNIT ECONOMICS & AVERAGES (KPI Subtitle Metrics)
// =====================================================================================

// Average Gross Billing Revenue per Visit (£)
[Avg Billing Amount Per Visit] = 
DIVIDE([Total Billing Amount], [Total Visits], 0)

// Average Medication Cost per Visit (£)
[Avg Medication Cost] = 
DIVIDE([Total Medication Cost], [Total Visits], 0)

// Average Treatment Cost per Visit (£)
[Avg Treatment Cost] = 
DIVIDE([Total Treatment Cost], [Total Visits], 0)

// Average Insurance Reimbursed per Visit (£)
[Avg Insurance Coverage] = 
DIVIDE([Total Insurance Coverage], [Total Visits], 0)

// Average Room Charges per Visit (£)
[Avg Room Charges] = 
DIVIDE([Total Room Charges], [Total Visits], 0)

// Average Out-of-Pocket Expense per Patient Visit (£)
[Avg Out Of Pocket] = 
DIVIDE([Total Out Of Pocket], [Total Visits], 0)


// =====================================================================================
// 6. CLINICAL DISTRIBUTION & RATIO MEASURES (Charts & Visuals)
// =====================================================================================

// Procedure % Share of Total Billing Amount (Denominator ignores visual slicing on Procedure)
[% Total Billing by Procedure] = 
DIVIDE(
    [Total Billing Amount],
    CALCULATE([Total Billing Amount], ALL(Visits[Procedure ID])),
    0
)

// Diagnosis % Share of Total Billing Amount
[% Total Billing by Diagnosis] = 
DIVIDE(
    [Total Billing Amount],
    CALCULATE([Total Billing Amount], ALL(Visits[Diagnosis ID])),
    0
)

// Department % Share of Total Billing Amount
[% Total Billing by Department] = 
DIVIDE(
    [Total Billing Amount],
    CALCULATE([Total Billing Amount], ALL(Visits[Department ID])),
    0
)

// Blank Measure (UI Design Trick: Used for Clean Bar Label Offsets in Power BI)
[Blank Measure] = BLANK()


// =====================================================================================
// 7. QUALITY OF CARE & SATISFACTION
// =====================================================================================

// Patient Satisfaction Average Score (1 - 10)
[Avg Satisfaction Score] = 
AVERAGE(Visits[Patient Satisfaction Score])

// Paid Visit Revenue Compliance
[Paid Visits %] = 
DIVIDE(
    CALCULATE([Total Visits], Visits[Payment Status] = "Paid"),
    [Total Visits],
    0
)
